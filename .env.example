# Node 24+. Nunca publique segredos reais.
APP_URL=http://localhost:3001
PORT=3001
DATABASE_PATH=./data/venus.sqlite
NODE_ENV=development

# Gere com: npm run admin:password
ADMIN_PASSWORD_HASH=

# Segundo fator (Base32). Gere com: npm run admin:totp
ADMIN_TOTP_SECRET=

# Segredo independente usado para gerar os códigos privados de acompanhamento das reservas.
# Gere com: npm run reservation:secret
RESERVATION_TOKEN_SECRET=

# Chave independente para autenticar a cadeia de auditoria. Gere com: npm run audit:secret
AUDIT_HMAC_SECRET=

# Produção: use uma chave aleatória de 32 bytes em Base64.
# Ex.: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

# Chave separada para proteger CPF em repouso. Gere com: npm run pii:key
# Produção: 32 bytes aleatórios em Base64, mantidos somente no secret manager.
PII_ENCRYPTION_KEY=

# Cache local do Guia Vênus sincronizado do repositório oficial.
GUIDE_CACHE_PATH=./data/guia-venus-pb.html

# Fonte autônoma do Guia. Em homologação, main pode ser usada.
# Em produção, substitua main pelo SHA do commit aprovado.
GUIDE_SOURCE_URL=https://raw.githubusercontent.com/Priscillacahino/Casa_de_praia_Venus/main/public/guia/index.html

# Produção: obrigatório. SHA-256 esperado do HTML remoto.
# Conteúdo divergente será rejeitado mesmo se a URL continuar respondendo.
GUIDE_EXPECTED_SHA256=

# Rotina manual de minimização de dados. Ajuste após validação jurídica/contábil.
RETENTION_DAYS=365

# Configure somente depois de confirmar quantos proxies reversos confiáveis existem.
# TRUST_PROXY_HOPS=1
